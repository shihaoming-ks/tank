# ==========================================
# 坦克竞技场 —— 环境变量示例
# 复制为 .env 后按需修改；.env 已被 gitignore
# 严禁将真实密钥提交到仓库
# ==========================================

# ---- 服务监听 ----
PORT=8080
HOST=0.0.0.0

# ---- 运行环境: development | production ----
NODE_ENV=development

# ---- 日志级别: debug | info | warn | error ----
LOG_LEVEL=info

# ---- WebSocket 来源白名单（逗号分隔，* 表示不限制） ----
ALLOWED_ORIGINS=*

# ==========================================
# 以下为后续接入内部基建时启用（MVP 阶段留空）
# ==========================================

# ---- MySQL 对局归档（可选，留空则跳过归档） ----
# MYSQL_HOST=
# MYSQL_PORT=3306
# MYSQL_USER=
# MYSQL_PASSWORD=
# MYSQL_DATABASE=

# ---- Appwrite（可选，用于大厅/身份） ----
# APPWRITE_ENDPOINT=
# APPWRITE_PROJECT_ID=
